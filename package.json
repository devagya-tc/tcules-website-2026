{
  "name": "tcules-website-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens:check": "node scripts/tokens-check.mjs",
    "specimens:check": "node scripts/specimens-check.mjs",
    "classes:check": "node scripts/classes-check.mjs",
    "aria:check": "node scripts/aria-check.mjs",
    "design:brief": "node scripts/design-brief.mjs",
    "design:check": "node scripts/design-brief.mjs --check",
    "vocabulary": "node scripts/design-brief.mjs --vocabulary > docs/vocabulary.md",
    "guide:dist": "node scripts/guide-dist.mjs",
    "verify": "npm run lint && npm run typecheck && npm run tokens:check && npm run classes:check && npm run specimens:check && npm run design:check",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
