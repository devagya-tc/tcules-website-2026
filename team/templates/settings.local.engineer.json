{
  "env": {
    "TCULES_MEMBER": "your-member-id",
    "TCULES_ROLE": "engineer"
  },
  "permissions": {
    "deny": [
      "Edit(/docs/decisions/**)",
      "Edit(/docs/brand/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/team/**)",
      "Bash(git push origin main)",
      "Bash(git push --force:*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/after-edit-check.mjs"],
            "timeout": 60,
            "statusMessage": "Checking the edit"
          }
        ]
      }
    ]
  }
}
