{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(../tcules-website/src/components/sections/**)",
      "Read(../tcules-website/src/components/layout/**)",
      "Read(../tcules-website/src/components/patterns/**)",
      "Read(../tcules-website/src/theme/**)",
      "Read(../tcules-website/tailwind.config.ts)",
      "Read(../tcules-website/src/app/**)",
      "Read(../tcules-website/src/lib/graphql/**)",
      "Read(../tcules-website/src/types/strapi/**)",
      "Read(../tcules-website/docs/**)",
      "Read(../tcules-website/cms-ready/**)",
      "Read(../tcules-website/.next/**)",
      "Read(../tcules-website/node_modules/**)"
    ],
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run tokens:check)",
      "Bash(npm run specimens:check)",
      "Bash(npm run design:check)",
      "Bash(npm run design:brief)",
      "Bash(npm run aria:check)",
      "Bash(npm run verify)",
      "Bash(npm run build)",
      "Bash(node scripts/tokens-check.mjs)",
      "Bash(node scripts/specimens-check.mjs)",
      "Bash(node scripts/design-brief.mjs:*)",
      "Bash(node scripts/aria-check.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run shots:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"],
            "timeout": 60,
            "statusMessage": "Catching up with GitHub"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/after-pr-checkout-main.sh\"",
            "timeout": 15,
            "statusMessage": "Returning to main"
          }
        ]
      }
    ]
  }
}
